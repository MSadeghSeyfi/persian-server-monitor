# ============================================================
#   تنظیمات ناظر امنیتی سرور
#   این فایل را کپی کنید: cp config.conf.example config.conf
# ============================================================

# پیام‌رسان: bale یا telegram
MESSENGER="bale"

# توکن ربات (از @BotFather دریافت کنید)
BOT_TOKEN="توکن_ربات_خود_را_اینجا_بگذارید"

# شناسه چت (Chat ID) — برای چند نفر با کاما جدا کنید
# مثال: CHAT_ID="111111,222222"
CHAT_ID="شناسه_چت_خود_را_اینجا_بگذارید"

# حدهای هشدار (درصد)
CPU_THRESHOLD=85
RAM_THRESHOLD=85
DISK_THRESHOLD=80

# سرویس‌هایی که باید مانیتور شوند (با کاما جدا کنید)
MONITOR_SERVICES="nginx,fail2ban,ssh"

# سایت‌هایی که باید مانیتور شوند (با کاما جدا کنید)
MONITOR_WEBSITES="https://example.com"

# IP های مورد اعتماد برای SSH (با کاما جدا کنید)
TRUSTED_IPS="1.2.3.4"
